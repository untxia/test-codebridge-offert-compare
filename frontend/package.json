{
  "name": "offer-compare-frontend-tools",
  "private": true,
  "description": "Build-time only: compiles Tailwind into ../public/vendor/tailwind.css (committed).",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o ../public/vendor/tailwind.css --minify",
    "build:js": "esbuild src/hero.js src/scroll.js src/stage3d.js --bundle --splitting --minify --format=esm --outdir=../public/vendor",
    "build": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lenis": "^1.3.26",
    "tailwindcss": "3.4.17",
    "three": "^0.186.1"
  }
}